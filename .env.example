# Backend API origin (proxied by Next.js rewrites)
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Optional: API Gateway key if your stack requires x-api-key
NEXT_PUBLIC_API_KEY=

# Server-side DynamoDB access for listing conversations from the database.
# On Amplify Hosting, set these in the app's environment variables.
AI_TRIAGE_STUDY_AWS_REGION=ca-central-1
AI_TRIAGE_STUDY_CONVERSATIONS_TABLE=ai-triage-study-conversations
# Amplify uses an SSR Compute role for credentials; do not add access keys here.
